{
  "name": "recipifyhub",
  "version": "1.0.0",
  "description": "A modern recipe management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check backend-fix.js && node --check firebase-store.js && node --check db-integration.js",
    "build": "npm run check"
  },
  "keywords": [
    "recipes",
    "cooking",
    "food",
    "nutrition",
    "mongodb"
  ],
  "author": "Shivam Pandey",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "firebase-admin": "^13.10.0",
    "lodash": "^4.17.21",
    "mongodb": "^5.9.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "openweathermap-ts": "^1.2.10"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
