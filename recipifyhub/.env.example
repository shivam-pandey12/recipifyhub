NODE_ENV=production
PORT=3000

# MongoDB Atlas URI used only for pre-stored recipe and restaurant fetching.
MONGODB_URI=replace-with-mongodb-atlas-uri

# Session security. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=recipifyhub.sid
SESSION_DB_NAME=recipifyhub
SESSION_COLLECTION=sessions
SESSION_TTL_SECONDS=604800

# Hosting/proxy/CORS.
PUBLIC_SITE_URL=https://your-domain.com
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://your-domain.com
REQUEST_BODY_LIMIT=50mb

# Firebase Admin for accounts, user recipes, saved data, comments, ratings, and plans.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-private-key-using-escaped-newlines

# Firebase browser auth config for email/password and Google provider login.
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# Optional.
DNS_SERVERS=8.8.8.8,1.1.1.1
